rules_version = '2';
// 송년회 퀴즈용 규칙. 모든 접속자는 익명 로그인을 합니다.
// 참가자는 자기 문서(players/{uid}, 자기 답안)만 쓸 수 있고, 진행 상태(rooms/*)는
// 로그인한 누구나 쓸 수 있습니다. 하루짜리 사내 행사라 운영자 계정 구분은 두지 않았습니다.
service cloud.firestore {
  match /databases/{db}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 20;
      allow delete: if request.auth != null;
    }
    // 이모지 퀴즈 답안: 문서 id 는 {문제번호}_{uid}, 본인만 씀
    match /rooms/emoji/answers/{aid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.pid == request.auth.uid
        && aid == string(request.resource.data.q) + "_" + request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 60;
      allow delete: if request.auth != null;
    }
    // 그 밖의 게임 상태 (운영자 화면이 씀)
    match /rooms/{room} {
      allow read, write: if request.auth != null;
    }
    match /rooms/{room}/{sub}/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !(room == "emoji" && sub == "answers");
    }
  }
}
